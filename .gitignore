cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/

# Sensitive / Config Files
v3_config.json
v4_config.json
v3_config.*.json
*.env
holdings-report-*.csv
FRED_API_KEY
README.md
# Flutter / Dart
**/build/
**/ios/Pods/
**/android/.gradle/
**/flutter_*.log
.dart_tool/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.iml

# Logs
*.log
logs/
EOFfirebase-debug.log
