{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daily_brief.py\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cockpit_activity.sh prompt" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cockpit_activity.sh tool" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cockpit_activity.sh response" } ] }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__commodity-ex",
      "WebSearch",
      "WebFetch",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  }
}
