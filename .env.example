# Copy to .env (gitignored) and fill in. The engine + MCP read these.
FMP_API_KEY=your_fmp_free_tier_key_here
# optional: lower the daily call cap (default 200, free tier allows 250)
# FMP_DAILY_BUDGET=200

# optional: Finnhub free-tier key — used by the matrix display node for company logos (/stock/profile2)
# and, for names Finnhub resolves, day-change % (/quote). yfinance covers TSX/TSX-V regardless.
FINNHUB_API_KEY=your_finnhub_free_key_here
